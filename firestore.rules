rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function admin(){return request.auth != null && request.auth.uid == 'REPLACE_ADMIN_UID';}
 match /menus/{id} {
 allow get: if admin() || resource.data.active == true && resource.data.expiryAt > request.time;
 allow list: if admin();
 allow create,update: if admin() && request.resource.data.owner == request.auth.uid;
 allow delete: if admin();
 }
 match /visits/{id} {
 allow read,create,delete: if admin();
 allow update: if admin() || (exists(/databases/$(database)/documents/menus/$(id)) && get(/databases/$(database)/documents/menus/$(id)).data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1);
 }
 }
}
